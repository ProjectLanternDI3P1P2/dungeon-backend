{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=dungeon;Username=dungeon"
  },
  "Grpc": {
    "Combat": {
      "Address": "http://combat:8081",
      "TimeoutSeconds": 5
    },
    "Rewards": {
      "Address": "http://reward:8081",
      "TimeoutSeconds": 5
    },
    "Resilience": {
      "Retry": {
        "MaxAttempts": 1
      },
      "CircuitBreaker": {
        "FailureThreshold": 5,
        "BreakDurationSeconds": 30
      }
    }
  },
  "Dungeon": {
    "Generation": {
      "RoomCount": 40,
      "FloorCount": 4
    },
    "Mobs": {
      "WanderRadius": 2,
      "Zombie": { "Cadence": "110", "AggroRange": 10, "Step": "Orthogonal", "Idle": "Wander" },
      "Bat": { "Cadence": "1110", "AggroRange": 5, "Step": "Diagonal", "Idle": "Wander" },
      "Goblin": { "Cadence": "1", "AggroRange": 3, "Step": "Orthogonal", "Idle": "NearestDoor" },
      "Mage": {
        "Cadence": "001",
        "AggroRange": null,
        "Step": "Teleport",
        "Idle": "None",
        "TeleportDistance": 3
      }
    }
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "dungeon.events"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Expressions"
    ],
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '%/health%' and (StatusCode is null or StatusCode = 200) or (RequestPath like '%/metrics%' and (StatusCode is null or StatusCode = 200))"
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level}] {Scope} {Message:lj} <s:{SourceContext}> [level:{level}]{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
