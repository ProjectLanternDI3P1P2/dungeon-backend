<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- x-release-please-start-version -->
    <Version>3.0.0</Version>
    <!-- x-release-please-end -->
    <PackageId>Dungeon.Contracts</PackageId>
    <Description>Public Protocol Buffers and generated gRPC types exposed by the Dungeon service.</Description>
    <PackageTags>grpc;protobuf;contracts</PackageTags>
    <PackageProjectUrl>https://github.com/ProjectLanternDI3P1P2/dungeon-backend</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ProjectLanternDI3P1P2/dungeon-backend.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.33.2" />
    <PackageReference Include="Grpc.Core.Api" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos/dungeon_player_v1.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/dungeon_run_v1.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/dungeon_events_v1.proto" GrpcServices="None" />
    <!-- Consumers that use another language can retrieve the source contract from the package. -->
    <None Include="Protos/dungeon_player_v1.proto" Pack="true" PackagePath="proto" />
    <None Include="Protos/dungeon_run_v1.proto" Pack="true" PackagePath="proto" />
    <None Include="Protos/dungeon_events_v1.proto" Pack="true" PackagePath="proto" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
