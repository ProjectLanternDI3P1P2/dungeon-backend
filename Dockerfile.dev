# syntax=docker/dockerfile:1.10
ARG DOTNET_VERSION=10.0
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION} AS build
WORKDIR /src
COPY NuGet.Local.config ./NuGet.config
COPY Dungeon.Presentation.slnx ./
COPY Dungeon.Contracts/Dungeon.Contracts.csproj Dungeon.Contracts/
COPY Dungeon.Domain/Dungeon.Domain.csproj Dungeon.Domain/
COPY Dungeon.Application/Dungeon.Application.csproj Dungeon.Application/
COPY Dungeon.Infrastructure/Dungeon.Infrastructure.csproj Dungeon.Infrastructure/
COPY Dungeon.Presentation/Dungeon.Presentation.csproj Dungeon.Presentation/
COPY Dungeon.Test/Dungeon.Test.csproj Dungeon.Test/
RUN --mount=type=cache,target=/root/.nuget/packages dotnet restore Dungeon.Presentation.slnx
COPY . .
RUN --mount=type=cache,target=/root/.nuget/packages dotnet publish Dungeon.Presentation/Dungeon.Presentation.csproj --configuration Release --output /app/publish --no-restore /p:UseAppHost=false
FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION} AS runtime
WORKDIR /app
ENV ASPNETCORE_ENVIRONMENT=Development ASPNETCORE_HTTP_PORTS=8080 DOTNET_RUNNING_IN_CONTAINER=true DOTNET_EnableDiagnostics=0
EXPOSE 8080 8081
COPY --from=build --chown=$APP_UID:$APP_UID /app/publish ./
USER $APP_UID
ENTRYPOINT ["dotnet", "Dungeon.Presentation.dll"]
